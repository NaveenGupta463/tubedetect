{
  "name": "tubeintel",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "npx kill-port 3001 3002 5173 --silent & concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:scoring\"",
    "dev:frontend": "vite",
    "dev:backend": "cd backend && npm run dev",
    "dev:scoring": "cd server && npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:scoring\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder",
    "lint:arch": "node scripts/lint-architecture.js"
  },
  "build": {
    "appId": "com.tubeintel.app",
    "productName": "TubeIntel",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*"
    ],
    "directories": {
      "output": "electron-dist"
    }
  },
  "dependencies": {
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^32.3.3",
    "electron-builder": "^25.0.0",
    "vite": "^5.4.2",
    "wait-on": "^8.0.5"
  }
}
