{
  "name": "tubeintel",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "predev": "npx kill-port 3001 3002 5173 5174 --silent",
    "dev": "concurrently --kill-others --kill-others-on-fail \"npm run dev:frontend-v2\" \"npm run dev:scoring\" \"npm run dev:worker\"",
    "dev:v1": "vite",
    "dev:all": "concurrently --kill-others --kill-others-on-fail \"npm run dev:frontend\" \"npm run dev:frontend-v2\" \"npm run dev:scoring\"",
    "dev:frontend": "vite",
    "dev:frontend-v2": "vite --config vite.v2.config.js",
    "dev:scoring": "cd server && npm run dev",
    "dev:worker": "cd server && npm run dev:worker",
    "dev:with-worker": "concurrently --kill-others --kill-others-on-fail \"npm run dev:frontend-v2\" \"npm run dev:scoring\" \"npm run dev:worker\"",
    "dev:server": "cd server && node index.js",
    "dev:server:watch": "cd server && npm run dev",
    "build": "vite build --config vite.v2.config.js",
    "build:v1": "vite build",
    "build:v2": "vite build --config vite.v2.config.js",
    "preview": "vite preview --config vite.v2.config.js",
    "preview:v1": "vite preview",
    "preview:v2": "vite preview --config vite.v2.config.js",
    "test:e2e": "playwright test",
    "electron:dev": "concurrently \"npm run dev:frontend\" \"npm run dev:scoring\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder",
    "lint:arch": "node scripts/lint-architecture.js"
  },
  "build": {
    "appId": "com.tubeintel.app",
    "productName": "TubeIntel",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*"
    ],
    "directories": {
      "output": "electron-dist"
    }
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "google-trends-api": "^4.9.2",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^32.3.3",
    "electron-builder": "^25.0.0",
    "vite": "^5.4.2",
    "wait-on": "^8.0.5"
  }
}
